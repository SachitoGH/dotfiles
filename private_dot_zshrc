# Launched from Windows (Win+R, admin, shortcut) WSL inherits C:\Windows\System32.
[[ $PWD == /mnt/c/Windows* ]] && cd ~

# =====================================================
# Tmux Autostart
# =====================================================
if command -v tmux &>/dev/null && \
   [[ -z "$TMUX" ]] && \
   [[ $- == *i* ]] && \
   [[ -z "$VSCODE_INJECTION" ]] && \
   [[ "$TERM_PROGRAM" != "vscode" ]] && \
   [[ "$INTELLIJ_ENVIRONMENT_READER" != "true" ]]; then
  # Replace the outer shell so leaving tmux also closes the terminal.
  exec tmux new-session -A -s main
fi

# =====================================================
# Powerlevel10k Instant Prompt (must stay near top)
# =====================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =====================================================
# Environment
# =====================================================
export EDITOR=nvim
(( $+commands[dircolors] )) && eval "$(dircolors -b)"

# Older WSL sessions may not receive an XDG runtime directory from systemd.
if [[ -n $WSL_DISTRO_NAME && ! -d $XDG_RUNTIME_DIR ]]; then
  export XDG_RUNTIME_DIR="/tmp/user-runtime-${UID}"
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
fi

# =====================================================
# History
# =====================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE

# =====================================================
# Zinit
# =====================================================
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
[[ -r "$ZINIT_HOME/zinit.zsh" ]] && source "$ZINIT_HOME/zinit.zsh"

# =====================================================
# Completion
# =====================================================
# Full compinit (rebuild + security check) at most once a day, cached otherwise.
# Called from the deferred plugin load below, so it doesn't delay the prompt.
function _zrc_compinit() {
  setopt local_options extended_glob
  local dump="${ZDOTDIR:-$HOME}/.zcompdump"
  autoload -Uz compinit
  if [[ -n $dump(#qN.mh+24) ]]; then
    compinit -d "$dump" && touch "$dump"
  else
    compinit -C -d "$dump"
  fi
}

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# =====================================================
# Keybindings
# =====================================================
bindkey -e
bindkey '^U' backward-kill-line

# Arrow keys: history prefix search
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
# terminfo keys work across terminals and tmux; fall back to raw sequences
bindkey "${terminfo[kcuu1]:-^[[A}" up-line-or-beginning-search
bindkey "${terminfo[kcud1]:-^[[B}" down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# Home/End/Delete and Ctrl+Left/Right word jumps
bindkey "${terminfo[khome]:-^[[H}" beginning-of-line
bindkey "${terminfo[kend]:-^[[F}"  end-of-line
bindkey "${terminfo[kdch1]:-^[[3~}" delete-char
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd (script cached, regenerated when fzf updates)
if (( $+commands[fzf] )); then
  _zrc_fzf="${XDG_CACHE_HOME:-$HOME/.cache}/fzf-init.zsh"
  [[ -s $_zrc_fzf && $_zrc_fzf -nt $commands[fzf] ]] || fzf --zsh >| "$_zrc_fzf"
  source "$_zrc_fzf"
  unset _zrc_fzf
fi

# =====================================================
# Plugins & Prompt
# =====================================================
if (( $+functions[zinit] )); then
  # The prompt loads now; everything else loads right after it is drawn (turbo mode).
  zinit ice depth=1
  zinit light romkatv/powerlevel10k
  [[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

  # fzf-tab must load after compinit and before fast-syntax-highlighting.
  if (( $+commands[fzf] )); then
    zstyle ':completion:*' menu no
    zstyle ':fzf-tab:complete:cd:*' fzf-preview \
      '[ -n "$realpath" ] && ls -a "$realpath" 2>/dev/null'
    zinit wait lucid light-mode atinit'_zrc_compinit; zicdreplay' for Aloxaf/fzf-tab
  else
    zstyle ':completion:*' menu select
    zinit wait lucid light-mode atinit'_zrc_compinit; zicdreplay' for zdharma-continuum/null
  fi

  zinit wait lucid light-mode atload'FAST_HIGHLIGHT_STYLES[unknown-token]="fg=white"' \
    for zdharma-continuum/fast-syntax-highlighting
else
  _zrc_compinit
fi

# Mark each prompt so tmux copy mode can jump between command blocks.
function _zrc_osc133_prompt_marker() {
  local exit_status=$?
  printf '\e]133;A\e\\'
  return $exit_status
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _zrc_osc133_prompt_marker

# Back to a bar cursor at every prompt (Neovim and other TUIs can leave a block behind).
function _zrc_reset_cursor() { printf '\e[6 q'; }
add-zsh-hook precmd _zrc_reset_cursor

# =====================================================
# Aliases
# =====================================================
alias nv=nvim
alias py=python3
alias grep='grep --color=auto'

# Start Live Server here, or serve a path passed as the first argument.
serve() {
  live-server "${1:-.}" "${@:2}"
}

# Update Ubuntu packages and Homebrew tools, then clean stale package caches.
update-tools() {
  sudo apt update &&
    sudo apt upgrade &&
    sudo apt autoclean &&
    brew update &&
    brew upgrade &&
    brew cleanup &&
    npm update --global &&
    npm cache verify
}

case "$OSTYPE" in
  darwin*) alias ls='ls -G' ;;
  *)       alias ls='ls --color=auto' ;;
esac

if [[ -n $WSL_DISTRO_NAME ]]; then
  alias openwin='explorer.exe'
fi
