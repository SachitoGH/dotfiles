# =====================================================
# Tmux Autostart
# =====================================================
if command -v tmux &>/dev/null && \
   [[ -z "$TMUX" ]] && \
   [[ $- == *i* ]] && \
   [[ -z "$VSCODE_INJECTION" ]] && \
   [[ "$TERM_PROGRAM" != "vscode" ]] && \
   [[ "$INTELLIJ_ENVIRONMENT_READER" != "true" ]]; then
  # Do not use `exec`: if tmux exits, return to Zsh instead of closing the terminal.
  tmux new-session -A -s main
fi

# =====================================================
# Powerlevel10k Instant Prompt (must stay near top)
# =====================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =====================================================
# Environment
# =====================================================
export EDITOR=nvim

# Older WSL sessions may not receive an XDG runtime directory from systemd.
if [[ ( -z "$XDG_RUNTIME_DIR" || ! -d "$XDG_RUNTIME_DIR" ) ]] &&
   grep -qi microsoft /proc/version 2>/dev/null; then
  export XDG_RUNTIME_DIR="/tmp/user-runtime-${UID}"
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
fi

# =====================================================
# History
# =====================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE

# =====================================================
# Zinit
# =====================================================
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
[[ -r "$ZINIT_HOME/zinit.zsh" ]] && source "$ZINIT_HOME/zinit.zsh"

# =====================================================
# Completion
# =====================================================
autoload -Uz compinit

# Use find instead of glob: glob qualifiers don't expand reliably in [[ ]] on WSL
_zrc_dump="${ZDOTDIR:-$HOME}/.zcompdump"
if [[ -f $_zrc_dump ]] && [[ $(find "$_zrc_dump" -mmin +1440 2>/dev/null) ]]; then
  compinit
else
  compinit -C
fi
unset _zrc_dump

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# =====================================================
# Vi Mode & Keybindings
# =====================================================
bindkey -v
KEYTIMEOUT=1

# Emacs-style bindings in insert mode
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^K' kill-line
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char

# Arrow keys: history prefix search
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
# terminfo keys work across terminals and tmux; fall back to raw sequences
bindkey -M viins "${terminfo[kcuu1]:-^[[A}" up-line-or-beginning-search
bindkey -M viins "${terminfo[kcud1]:-^[[B}" down-line-or-beginning-search
bindkey -M viins '^[[A' up-line-or-beginning-search
bindkey -M viins '^[[B' down-line-or-beginning-search
bindkey -M vicmd 'k'    up-line-or-beginning-search
bindkey -M vicmd 'j'    down-line-or-beginning-search

# Cursor shape: beam in insert, block in normal
autoload -Uz add-zle-hook-widget
function _zrc_cursor_beam()  { printf '\e[6 q'; }
function _zrc_cursor_block() { [[ $KEYMAP == vicmd ]] && printf '\e[2 q' || printf '\e[6 q'; }
add-zle-hook-widget zle-line-init      _zrc_cursor_beam
add-zle-hook-widget zle-keymap-select  _zrc_cursor_block

# =====================================================
# Plugins & Prompt
# =====================================================
if (( $+functions[zinit] )); then
  if command -v fzf &>/dev/null; then
    zinit light Aloxaf/fzf-tab
    zstyle ':fzf-tab:complete:cd:*' fzf-preview \
      '[ -n "$realpath" ] && ls -a "$realpath" 2>/dev/null'
  fi

  zinit light zdharma-continuum/fast-syntax-highlighting
  FAST_HIGHLIGHT_STYLES[unknown-token]="fg=white"

  zinit ice depth=1
  zinit light romkatv/powerlevel10k
  [[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
fi

# =====================================================
# Aliases
# =====================================================
alias nv=nvim
alias py=python3
alias grep='grep --color=auto'

case "$OSTYPE" in
  darwin*) alias ls='ls -G' ;;
  *)       alias ls='ls --color=auto' ;;
esac

if grep -qi microsoft /proc/version 2>/dev/null; then
  alias open='explorer.exe'
  alias gowin='cd /mnt/c/Users/sacho'
fi
