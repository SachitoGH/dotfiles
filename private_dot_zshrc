# =====================================================
# Tmux Autostart
# =====================================================
if command -v tmux &>/dev/null && \
   [[ -z "$TMUX" ]] && \
   [[ $- == *i* ]] && \
   [[ -z "$VSCODE_INJECTION" ]] && \
   [[ "$TERM_PROGRAM" != "vscode" ]] && \
   [[ "$INTELLIJ_ENVIRONMENT_READER" != "true" ]]; then
  exec tmux new-session
fi

# =====================================================
# Powerlevel10k Instant Prompt (must stay near top)
# =====================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =====================================================
# Environment
# =====================================================
export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR=vim
else
  export EDITOR=nvim
fi

# WSL: systemd-logind doesn't reliably create XDG_RUNTIME_DIR
if [[ -n "$XDG_RUNTIME_DIR" && ! -d "$XDG_RUNTIME_DIR" ]]; then
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
fi

# =====================================================
# History
# =====================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE

# =====================================================
# Zinit Bootstrap
# =====================================================
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
if [[ ! -d $ZINIT_HOME ]]; then
  print -P "%F{yellow}[zinit] Installing...%f"
  mkdir -p "${ZINIT_HOME:h}"
  if ! git clone --depth=1 https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME" 2>/dev/null; then
    print -P "%F{red}[zinit] Clone failed — plugins will not load.%f"
  fi
fi
[[ -f "$ZINIT_HOME/zinit.zsh" ]] && source "$ZINIT_HOME/zinit.zsh"

# =====================================================
# Completion
# =====================================================
autoload -Uz compinit

# Use find instead of glob: glob qualifiers don't expand reliably in [[ ]] on WSL
_zrc_dump="${ZDOTDIR:-$HOME}/.zcompdump"
if [[ -f $_zrc_dump ]] && [[ $(find "$_zrc_dump" -mmin +1440 2>/dev/null) ]]; then
  compinit
else
  compinit -C
fi
unset _zrc_dump

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# =====================================================
# Vi Mode & Keybindings
# =====================================================
bindkey -v
KEYTIMEOUT=1

# Emacs-style bindings in insert mode
bindkey -M viins '^A' beginning-of-line
bindkey -M viins '^E' end-of-line
bindkey -M viins '^K' kill-line
bindkey -M viins '^U' backward-kill-line
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char

# Arrow keys: history prefix search
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey -M viins '^[[A' up-line-or-beginning-search
bindkey -M viins '^[[B' down-line-or-beginning-search
bindkey -M vicmd 'k'    up-line-or-beginning-search
bindkey -M vicmd 'j'    down-line-or-beginning-search

# .. expands to ../
function rationalise-dot() {
  [[ $LBUFFER = *.. ]] && LBUFFER+=/.. || LBUFFER+=.
}
zle -N rationalise-dot
bindkey .           rationalise-dot
bindkey -M isearch . self-insert

# Cursor shape: beam in insert, block in normal
autoload -Uz add-zle-hook-widget
function _zrc_cursor_beam()  { printf '\e[6 q'; }
function _zrc_cursor_block() { [[ $KEYMAP == vicmd ]] && printf '\e[2 q' || printf '\e[6 q'; }
add-zle-hook-widget zle-line-init      _zrc_cursor_beam
add-zle-hook-widget zle-keymap-select  _zrc_cursor_block

# =====================================================
# Plugins & Prompt
# =====================================================
if command -v fzf &>/dev/null; then
  zinit light Aloxaf/fzf-tab
  zstyle ':fzf-tab:complete:cd:*' fzf-preview \
    '[ -n "$realpath" ] && ls --color=always "$realpath" 2>/dev/null'
fi

zinit light zdharma-continuum/fast-syntax-highlighting
FAST_HIGHLIGHT_STYLES[unknown-token]="fg=white"

zinit ice depth=1
zinit light romkatv/powerlevel10k
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# =====================================================
# Aliases
# =====================================================
alias nv=nvim
alias py=python3
alias grep='grep --color=auto'

case "$OSTYPE" in
  darwin*) alias ls='ls -G';           alias ll='ls -alFG' ;;
  *)       alias ls='ls --color=auto'; alias ll='ls -alF'  ;;
esac

if grep -qi microsoft /proc/version 2>/dev/null; then
  alias open='explorer.exe'
  alias gowin='cd /mnt/c/Users/sacho'
fi

# =====================================================
# Functions
# =====================================================

# Sync ~/.config/nvim → chezmoi (handles edits, additions, and deletions)
nvim-sync() {
  chezmoi re-add ~/.config/nvim

  chezmoi managed --include=files | grep '\.config/nvim' | while read -r rel; do
    local dest="$HOME/$rel"
    if [[ ! -e "$dest" ]]; then
      local src
      src=$(chezmoi source-path "$dest" 2>/dev/null)
      [[ -n "$src" && -f "$src" ]] && rm -v "$src"
    fi
  done

  chezmoi apply ~/.config/nvim
}
