# Claude Code: only the shared config (settings, status line, hooks) is tracked;
# credentials, history, sessions and settings.local.json stay machine-specific.
.claude/*
!.claude/settings.json
!.claude/statusline.sh
!.claude/hooks
# Project-level .claude folders (e.g. inside the exact_ nvim dir) must never be tracked or removed.
.config/**/.claude
.config/**/.claude/**

# Repository documentation is not a home-directory dotfile
README.md
